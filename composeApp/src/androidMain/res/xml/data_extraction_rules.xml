<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12以降（API 31+）のバックアップ／端末間移行の設定。

  APIキーと自宅座標を入れた walking_rpg_secrets.xml を、クラウドバックアップと
  端末間移行の両方から除外する（理由は backup_rules.xml のコメント参照）。
  ファイル名は AndroidSecureStorage.PREFS_NAME と一致させること。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="walking_rpg_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="walking_rpg_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
