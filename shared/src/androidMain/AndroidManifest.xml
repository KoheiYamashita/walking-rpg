<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 測位（architecture.md §5）。歩行の軌跡が要るので FINE を使う -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 記録中の保険（画面オフ・ロック時にプロセスを落とされないため） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 歩数計（design.md §3「開始を押し忘れた日」）。許可されていなければ黙って
         取り込まない（HealthConnectDailyStepsSource）ので、無くても他の機能は動く。
         許可を求める導線は #16 / #20 で作る -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Android 13以前の Health Connect は別アプリ。入っているかを問い合わせるのに要る
         （Android 14以降はOS側にあるので、この宣言は無視される） -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>

        <service
            android:name="com.walkingrpg.shared.platform.WalkRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- エクスポートしたJSONを共有UIに渡すためのFileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/walking_rpg_file_paths" />
        </provider>
    </application>

</manifest>
