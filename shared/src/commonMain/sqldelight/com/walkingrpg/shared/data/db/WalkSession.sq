-- 真実の源（architecture.md §4「イベント系。絶対に消さない」）。
-- 導出テーブルは location_sample / passage から再計算できること。

CREATE TABLE walk_session (
    id         INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    started_at INTEGER NOT NULL,  -- epoch millis
    ended_at   INTEGER,           -- 記録中は NULL
    end_reason TEXT               -- SessionEndReason の name。記録中は NULL
);

CREATE INDEX walk_session_started_at ON walk_session(started_at);

insertSession:
INSERT INTO walk_session(started_at, ended_at, end_reason)
VALUES (?, NULL, NULL);

lastInsertedId:
SELECT last_insert_rowid();

endSession:
UPDATE walk_session
SET ended_at = :endedAt, end_reason = :endReason
WHERE id = :id AND ended_at IS NULL;

-- アプリが強制終了した場合に開きっぱなしになったセッションを畳む。
-- ended_at は「そのセッションで最後に取れた測位サンプルの時刻」（1件も無ければ started_at）。
-- 畳む処理を走らせた時刻（＝次回の起動・開始時刻）を入れると、
-- 数日後に起動しただけで継続時間が何日にも化けてしまう。
-- 畳む対象のID。UPDATE の前に同じトランザクションで引く
-- （畳んだあとでは ended_at IS NULL では引けなくなるため）。
-- 呼び出し側はこのIDで導出（passage → way_growth）を作り直す。
selectOpenSessionIds:
SELECT id
FROM walk_session
WHERE ended_at IS NULL
ORDER BY id;

abandonOpenSessions:
UPDATE walk_session
SET ended_at = COALESCE(
        (SELECT MAX(l.ts) FROM location_sample l WHERE l.session_id = walk_session.id),
        started_at
    ),
    end_reason = :endReason
WHERE ended_at IS NULL;

selectSession:
SELECT id, started_at, ended_at, end_reason
FROM walk_session
WHERE id = ?;

-- 振り返りの一言（llm_cache）を作る候補＝直近の終了済みセッション（新しい順）。
-- 過去全件を返さないのは、半年前の散歩に今から文章を付けても誰も開かないから
-- （件数の根拠は LlmGenerationConfig.DEFAULT_WALK_REVIEW_SESSION_LIMIT）。
-- 記録中（ended_at IS NULL）は含めない：まだ内容が確定していない。
selectRecentFinishedSessions:
SELECT id, started_at, ended_at, end_reason
FROM walk_session
WHERE ended_at IS NOT NULL
ORDER BY ended_at DESC, id DESC
LIMIT :limit;

selectSessionSummaries:
SELECT
    s.id,
    s.started_at,
    s.ended_at,
    s.end_reason,
    (SELECT COUNT(*) FROM location_sample l WHERE l.session_id = s.id) AS sample_count
FROM walk_session s
ORDER BY s.started_at DESC;
