# scripts/local-config のひな形。
#
#   cp scripts/local-config.example scripts/local-config
#
# コピー先（scripts/local-config）は .gitignore 済み。
# 対象圏の座標は個人情報なので、絶対にコミットしないこと。

# 切り出す範囲: W,S,E,N（経度min,緯度min,経度max,緯度max）
# 自宅を中心にするなら、自宅がbboxの中心に来ないよう少しずらすと安全。
# 下の値はダミー（大西洋上の Null Island 付近）。自分の対象圏に書き換える。
BBOX="-0.02,-0.02,0.02,0.02"

# ズーム範囲。散歩用途なら 15 前後まであれば足りる（上げるとサイズが跳ねる）
MINZOOM=8
MAXZOOM=15

# 出力先。既定は composeApp/src/androidMain/assets/map/area.pmtiles
# OUT="/path/to/area.pmtiles"

# 使用する planet ビルド。未指定なら直近の日次ビルドを自動で探す
# PLANET="https://build.protomaps.com/20260101.pmtiles"
